# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres (Vercel + local)
# Use the pooled connection (port 6543) for the serverless runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
# Use the direct connection (port 5432) for prisma db push / migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Auth
JWT_SECRET=
ADMIN_PASSWORD=

# Optional AI
OPENAI_API_KEY=

# Optional: only needed if the frontend is hosted on a different origin than the API
# VITE_API_URL=
